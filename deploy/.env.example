# Copy to /srv/glucocare/.env on the VPS. Never commit the real file.
POSTGRES_DB=glucocare
POSTGRES_USER=glucocare_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
GLUCOCARE_SESSION_DAYS=30
GLUCOCARE_PUBLIC_API_URL=https://api.example.invalid
GLUCOCARE_CORS_ORIGIN=https://app.example.invalid
GLUCOCARE_ALERT_QUEUE_BACKLOG_LIMIT=100
# Optional HMAC secret for provider delivery callbacks. Leave empty until a
# reviewed HTTPS callback route is configured.
GLUCOCARE_PROVIDER_CALLBACK_SECRET=
# Optional provider credentials. Leave empty to keep alerts visibly not_configured.
GLUCOCARE_RESEND_API_KEY=
GLUCOCARE_RESEND_FROM=
GLUCOCARE_TWILIO_ACCOUNT_SID=
GLUCOCARE_TWILIO_AUTH_TOKEN=
GLUCOCARE_TWILIO_FROM=
