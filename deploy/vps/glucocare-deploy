#!/usr/bin/env bash
set -euo pipefail

# Installed as /usr/local/sbin/glucocare-deploy on the VPS and referenced by the
# forced-command deploy key. The wrapper accepts a gzipped repository archive on
# stdin and never grants the GitHub Actions key an interactive shell.
base=/srv/glucocare
incoming="$base/.incoming"
release="$base/release"
previous="$base/release.previous"
history="$base/releases"
env_file="$base/.env"

test -r "$env_file"
test "$(stat -c '%a' "$env_file")" = 600

install -d -o glucocare-deploy -g glucocare-deploy -m 0750 "$history"

rm -rf "$incoming"
install -d -o glucocare-deploy -g glucocare-deploy -m 0750 "$incoming"
tar --extract --gzip --file=- --directory="$incoming"

rm -rf "$previous"
if [ -d "$release" ]; then mv "$release" "$previous"; fi
mv "$incoming" "$release"

rollback() {
  rm -rf "$release"
  if [ -d "$previous" ]; then
    mv "$previous" "$release"
    /usr/bin/docker compose --env-file "$env_file" --project-name glucocare \
      -f "$release/deploy/compose.yml" up -d --build --remove-orphans || true
  fi
}

wait_for_health() {
  for _ in $(seq 1 30); do
    web_status=$(/usr/bin/docker inspect --format '{{.State.Health.Status}}' glucocare-glucocare-web-1 2>/dev/null || true)
    docs_status=$(/usr/bin/docker inspect --format '{{.State.Health.Status}}' glucocare-docs 2>/dev/null || true)
    api_status=$(/usr/bin/docker inspect --format '{{.State.Health.Status}}' glucocare-glucocare-api-1 2>/dev/null || true)
    db_status=$(/usr/bin/docker inspect --format '{{.State.Health.Status}}' glucocare-glucocare-db-1 2>/dev/null || true)
    if [ "$web_status" = healthy ] && [ "$docs_status" = healthy ] && [ "$api_status" = healthy ] && [ "$db_status" = healthy ] && /usr/bin/curl --fail --silent --head http://127.0.0.1:18082/ >/dev/null && /usr/bin/curl --fail --silent http://127.0.0.1:18084/healthz >/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

# Older deployments used the generic Compose project name "deploy" and an
# explicit container name. Remove only this app's old container before adopting
# the explicit "glucocare" project name; other VPS services are untouched.
/usr/bin/docker rm --force glucocare-docs >/dev/null 2>&1 || true

if ! /usr/bin/docker compose --env-file "$env_file" --project-name glucocare \
    -f "$release/deploy/compose.yml" up -d --build --remove-orphans; then
  rollback
  exit 1
fi

if ! wait_for_health; then
  rollback
  exit 1
fi

if [ -d "$previous" ]; then
  # Keep a small, local release history so an operator can roll back after the
  # one-shot previous-release window has already been consumed.
  snapshot="$history/$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mv "$previous" "$snapshot"
  find "$history" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' \
    | sort -nr \
    | tail -n +4 \
    | cut -d' ' -f2- \
    | xargs -r rm -rf
fi
/usr/bin/docker image prune --force --filter "until=168h" >/dev/null || true
