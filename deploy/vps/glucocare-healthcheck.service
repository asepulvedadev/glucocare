[Unit]
Description=GlucoCare synthetic staging health check
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=glucocare-deploy
Group=glucocare-deploy
ExecStart=/srv/glucocare/release/deploy/vps/glucocare-healthcheck
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/glucocare/release

[Install]
WantedBy=multi-user.target
